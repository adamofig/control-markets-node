#!/usr/bin/env node
/**
 * `cm` — the universal reader.
 *
 * One address space, over plain HTTP, with no dependencies. Exists for every runtime that has a
 * shell but not our tools: an ACP engine with only `run_command`, a terminal, a Python script, n8n.
 *
 *   cm read cm://skill/agent-profile-specs:sync
 *   cm read cm://source/6a52a32f1aac54b41b78f2bb > /tmp/doc.md
 *   cm read cm://task/<id> --json
 *   cm read cm://skill/<slug> --org 6a27c95e18f26467e443f298
 *
 * Environment:
 *   CONTROL_MARKETS_BACKEND_URL   default: CM_MCP_URL without its /mcp suffix, else localhost:8121
 *   CONTROL_MARKETS_PAT           the `cm_pat_*` token (CONTROL_MARKETS_TOKEN / CM_PAT also read)
 *                                 inside an ACP session, CM_MCP_TOKEN (the session's `cm_eat_*`)
 *   CM_ORG_ID                     the organization to read as (CONTROL_MARKETS_ORG_ID also read).
 *                                 Only consulted by tokens that carry no organization of their own;
 *                                 a `cm_pat_*` or `cm_eat_*` already knows its tenant and the
 *                                 server ignores the header for them.
 *
 * **It speaks HTTP, not Mongo, on purpose.** Handing an agent database credentials would couple it
 * to the schema — every migration would break every agent at once — and would put the organization
 * filter out of reach of the one place that enforces it. The scoping lives in the service layer;
 * this is a client of that layer, never a way around it.
 */
const fs = require('fs');
const path = require('path');
const os = require('os');

function loadEnv() {
  const startDirs = [process.cwd(), __dirname].filter(Boolean);
  const searched = new Set();
  const foundFiles = [];

  for (const startDir of startDirs) {
    let current = path.resolve(startDir);
    while (current && !searched.has(current)) {
      searched.add(current);
      const candidate = path.join(current, '.env');
      if (fs.existsSync(candidate)) {
        foundFiles.push(candidate);
      }
      const parent = path.dirname(current);
      if (parent === current) break;
      current = parent;
    }
  }

  const extraCandidates = [path.join(os.homedir(), '.control-markets', '.env')];
  for (const candidate of extraCandidates) {
    if (fs.existsSync(candidate) && !foundFiles.includes(candidate)) {
      foundFiles.push(candidate);
    }
  }

  for (const file of foundFiles) {
    try {
      const content = fs.readFileSync(file, 'utf8');
      for (const line of content.split('\n')) {
        const trimmed = line.trim();
        if (!trimmed || trimmed.startsWith('#')) continue;
        const eqIdx = trimmed.indexOf('=');
        if (eqIdx === -1) continue;
        const key = trimmed.slice(0, eqIdx).trim();
        let val = trimmed.slice(eqIdx + 1).trim();
        if ((val.startsWith('"') && val.endsWith('"')) || (val.startsWith("'") && val.endsWith("'"))) {
          val = val.slice(1, -1);
        }
        if (key && !(key in process.env)) {
          process.env[key] = val;
        }
      }
    } catch {}
  }
}
loadEnv();

const [, , command, ...rest] = process.argv;

const BASE_URL = (
  process.env.CONTROL_MARKETS_BACKEND_URL ||
  // Inside an ACP turn the bridge already told the CLI where we live (`http://127.0.0.1:8121/mcp`).
  // Reusing it keeps `cm` on loopback in a container without anybody configuring a second variable.
  (process.env.CM_MCP_URL ? process.env.CM_MCP_URL.replace(/\/mcp\/?$/, '') : '') ||
  (process.env.PORT ? `http://localhost:${process.env.PORT}` : 'http://localhost:8121')
).replace(/\/$/, '');
const TOKEN =
  process.env.CONTROL_MARKETS_PAT ||
  process.env.CONTROL_MARKETS_TOKEN ||
  process.env.CM_PAT ||
  // The session's own ephemeral `cm_eat_*`, inherited from the process that spawned the CLI. It is
  // the right credential precisely because it is the weakest one available: one organization, one
  // TTL, the scopes that session was granted — and it means a deployed agent can read a document
  // through the shell without a personal token ever being written into an image or an env file.
  process.env.CM_MCP_TOKEN ||
  process.env.SYSTEM_MASTER_TOKEN ||
  process.env.CONTROL_MASTER_TOKEN;

// The master token authenticates as a platform principal with no tenant of its own, so without this
// the server has nothing to scope the read by. It used to substitute the caller's user id, which
// turned "you did not say which organization" into a 404 on a document that exists.
const ENV_ORG_ID = process.env.CM_ORG_ID || process.env.CONTROL_MARKETS_ORG_ID || process.env.ORG_ID;

const USAGE = `cm — lector universal de Control Markets

  cm read <cm://...> [--json] [--profile <id>] [--org <orgId>]

Direcciones:
  cm://skill/<bundle>                        la skill y el índice de sus capacidades
  cm://skill/<bundle>:<capacidad>            una capacidad atómica (preferila)
  cm://skill/<bundle>:<capacidad>/<archivo>  un documento embebido
  cm://source/<id>                           documento, memoria o exploración
  cm://task/<id>                             tarea con sus subtareas
  cm://profile/<id>/context                  contexto compilado de otro agente

Entorno: CONTROL_MARKETS_BACKEND_URL, CONTROL_MARKETS_PAT, CM_ORG_ID`;

const die = (message, code = 1) => {
  process.stderr.write(`${message}\n`);
  process.exit(code);
};

async function read(args) {
  // Skip the values of flags that take one, so `cm read --org <id> cm://...` finds the address.
  const flagsWithValue = ['--profile', '--org'];
  const positional = args.filter((arg, i) => !arg.startsWith('--') && !flagsWithValue.includes(args[i - 1]));
  const uri = positional[0];
  if (!uri) die(USAGE, 2);
  if (!TOKEN) die('Falta el token: exportá CONTROL_MARKETS_PAT con tu `cm_pat_*`.', 2);

  const profileIndex = args.indexOf('--profile');
  const params = new URLSearchParams({ uri });
  if (profileIndex >= 0 && args[profileIndex + 1]) params.set('profileId', args[profileIndex + 1]);

  // The organization travels in a header, never in the query string, for the same reason the
  // controller refuses `?orgId=`: the address is public, the identity is not. The server validates
  // membership before honouring it, so this is a request, not an assertion.
  const orgIndex = args.indexOf('--org');
  const orgId = (orgIndex >= 0 && args[orgIndex + 1]) || ENV_ORG_ID;

  const headers = { Authorization: `Bearer ${TOKEN}` };
  if (orgId) headers['x-org-id'] = orgId;

  const response = await fetch(`${BASE_URL}/api/cm/resource?${params}`, { headers });
  const body = await response.text();

  if (!response.ok) {
    let detail = body;
    try {
      detail = JSON.parse(body).message || body;
    } catch {}
    die(`[${response.status}] ${detail}`);
  }

  const resource = JSON.parse(body);
  if (args.includes('--json')) {
    process.stdout.write(`${JSON.stringify(resource, null, 2)}\n`);
    return;
  }

  // Plain mode writes the document to stdout and everything ABOUT it to stderr, so `cm read … > x.md`
  // produces the document byte for byte while the operator still sees the index and the warnings.
  process.stdout.write(resource.content ?? '');
  if (resource.children?.length) {
    process.stderr.write(`\nCapacidades de ${resource.uri}:\n${resource.children.map(c => `  ${c.uri}${c.description ? ` — ${c.description}` : ''}`).join('\n')}\n`);
  }
  if (resource.scripts?.length) {
    process.stderr.write(`\nEjecutables (rutas del workspace, no contenido):\n${resource.scripts.map(s => `  ${s}`).join('\n')}\n`);
  }
  if (resource.truncated) process.stderr.write('\n⚠️  Contenido truncado — pedí algo más acotado.\n');
}

(async () => {
  switch (command) {
    case 'read':
      return read(rest);
    case 'help':
    case '--help':
    case '-h':
    case undefined:
      return process.stdout.write(`${USAGE}\n`);
    default:
      die(`Comando desconocido \`${command}\`.\n\n${USAGE}`, 2);
  }
})().catch(err => die(`cm: ${err?.message || err}`));
