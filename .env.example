ENV=dev
PROJECT_ID=control-markets

# Database
MONGODB_URI=mongodb+srv://XXXX:XXXXXX@cluster.XXXXX.mongodb.net/control_markets?retryWrites=true&w=majority

# Google Cloud
GOOGLE_CLOUD_PROJECT_ID=control-markets-XXXXX
GOOGLE_APPLICATION_CREDENTIALS=./.cred/control-key.json
STORAGE_BUCKET=XXXXXX

# AI Services 
GROQ_API_KEY=gsk_XXXXX
OPENAI_API_KEY=sk-XXXXXXX
GEMINI_API_KEY=AIzaXXXXXX

# Special vars to integrate with chatwoot.
CHATWOOT_API_KEY=XXXXXX
CHATWOOT_HOST=https://chatwoot.yourproject.com


AI_SERVICES_HOST=http://localhost:3330 # For Self AI Client Http
# Discord Settings
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_TEST_USERNAME=

GITHUB_TOKEN=tu_token_de_github_aqui

# Local Agent harness (only on local machines, never in cloud deploys)
LOCAL_AGENT_MODE=false
LOCAL_AGENT_WORKSPACE_ROOTS=
# Optional: force the model used by the Codex ACP adapter instead of its advertised default.
# LOCAL_AGENT_CODEX_MODEL=gpt-5.6-terra
# LOCAL_AGENT_CODEX_REASONING_EFFORT=low

# Telegram messaging channel (MessagingModule)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Control Inbox — agent identity and PAT delegation
# Per-process limit for PAT-delegated sends, keyed by user + profile + recipient.
INBOX_AGENT_PAT_RATE_LIMIT_PER_MINUTE=30
# Agentic Profile used by task automations. Defaults to Zazu's profile when omitted.
INBOX_TASK_AGENTIC_PROFILE_ID=6a6e5c9a6bf9cbb98d96cda9
KEY_BALANCER_HOST=http://192.168.2.6:3333

# System Master Token — platform-owned credential for infrastructure callers
# (cronjobs, control-render workers, agentic runners, maintenance CLIs).
# Generate with: npm run generate:master-token. Never commit it, never store it in MongoDB.
# Accepts a comma-separated list so tokens can be rotated without downtime.
SYSTEM_MASTER_TOKEN=
# Identity the master token acts as by default (email or user id). Strongly recommended:
# without it the token runs as the synthetic `system_root` principal, which has admin claims
# but no row in the `users` collection, so endpoints that look the caller up will fail.
SYSTEM_MASTER_USER=
